# ---------------------------------------------------------------------------
# Lighter Stage Sync for GridPane — configuration
#
# Copy this file to ".env" (which is git-ignored) and fill in your own sites:
#     cp .env.example .env
#
# SITES is a newline-separated list. Each line maps an SSH host alias to a
# live (production) domain:
#
#     <ssh_alias>|<live_domain>
#
# - <ssh_alias>   the "Host" entry from your ~/.ssh/config — i.e. whatever you
#                 type after `ssh` to connect (e.g. `ssh bo` -> alias is "bo").
#                 The alias must carry the user, hostname and key, for example:
#
#                     Host bo
#                         HostName 231.x.x.x
#                         User root
#                         IdentityFile ~/.ssh/your_key
#
# - <live_domain> the production domain. The staging site is derived
#                 automatically as "staging.<live_domain>".
#
# Lines starting with "#" and blank lines are ignored.
# ---------------------------------------------------------------------------

SITES="
bo|example.com
bo|shop.example.com
ko|another-site.com
"

# ---------------------------------------------------------------------------
# Optional: automatic staging neutralization.
#
# Path to your PRIVATE staging-neutralize-kit repo. After a FULL-database
# import (sync option 1 or 3), if this is set AND the kit has a matching
# sites/<live_domain>/ folder, that staging site is neutralized automatically:
# production credentials scrubbed, outbound APIs/email/webhooks blocked,
# dangerous crons/queues killed.
#
# Leave empty (or remove) to disable. Option 2 (wp_posts only) never triggers it.
# ---------------------------------------------------------------------------

STAGING_KIT_DIR=""
